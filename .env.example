# Public UI and REST endpoints used by Page Objects and Service Objects.
PARABANK_BASE_URL=https://parabank.parasoft.com/parabank
PARABANK_API_URL=https://parabank.parasoft.com/parabankv2/services/bank

# Shared demonstration customer used by authenticated scenarios.
PARABANK_USERNAME=john
PARABANK_PASSWORD=demo

# Browser engine, visibility, and optional action delay in milliseconds.
BROWSER=chromium
HEADLESS=true
SLOW_MO=0
# Default locator and navigation timeouts in milliseconds.
DEFAULT_TIMEOUT=15000
NAVIGATION_TIMEOUT=30000
# Evidence controls: capture each BDD step and clean previous results when enabled.
EVIDENCE_EACH_STEP=false
CLEAN_RESULTS=false
